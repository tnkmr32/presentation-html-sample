{
  "language": "japanese",
  "permissions": {
    "allow": [
      "Read(~/Projects/**)",
      "Write(~/Projects/**)",
      "Edit(~/Projects/**)",
      "Bash(python3 *)",
      "Bash(python3 -)",
      "Bash(pip3 install *)",
      "Bash(curl -sL *)",
      "Bash(awk *)",
      "Bash(ls *)",
      "Bash(diff *)",
      "Bash(cd ~/Projects/presentation-html-sample)",
      "Bash(cd ~/Projects/presentation-html-sample/*)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh stop"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/notify.sh notification"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/open-tab-on-first-prompt.sh prompt",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/open-tab-on-first-prompt.sh mark"
          }
        ]
      }
    ]
  }
}
